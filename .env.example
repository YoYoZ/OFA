# Copy to .env and adjust:  cp .env.example .env

# Admin panel password. If empty, a random one is generated on first start,
# saved to data/admin_password.txt and printed in the logs.
ADMIN_PASSWORD=

# Secret for signing admin session cookies. If empty, one is generated and saved to data/.session_secret.
SESSION_SECRET=

# Public base URL used for share links, e.g. https://review.example.com
# If empty, it is derived from the incoming request.
PUBLIC_URL=

# Set when running behind a reverse proxy (nginx, Caddy, Traefik) so client IPs
# and HTTPS are detected correctly: true | number of hops | IP/subnet list
TRUST_PROXY=

# Comma-separated list of extra origins allowed to call the API (CORS). Usually empty.
ALLOWED_ORIGIN=

# Host port to publish (docker compose only)
OFA_PORT=3000
