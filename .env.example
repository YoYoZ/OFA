# Copy to .env and adjust:  cp .env.example .env

# Admin panel password. If empty, a random one is generated on first start,
# saved to data/admin_password.txt and printed in the logs.
ADMIN_PASSWORD=

# Secret for signing admin session cookies. If empty, one is generated and saved to data/.session_secret.
SESSION_SECRET=

# Public base URL used for share links, e.g. https://review.example.com
# If empty, it is derived from the incoming request.
PUBLIC_URL=

# Set when running behind a reverse proxy (nginx, Caddy, Traefik) so client IPs
# and HTTPS are detected correctly: true | number of hops | IP/subnet list
TRUST_PROXY=

# Comma-separated list of extra origins allowed to call the API (CORS). Usually empty.
ALLOWED_ORIGIN=

# Host port to publish (docker compose only). Behind a reverse proxy: 127.0.0.1:3000
OFA_PORT=3000

# Optional single sign-on for the admin panel via your auth proxy (Authelia, oauth2-proxy, …).
# Header that carries the signed-in user name. ONLY when OFA is reachable solely through
# that proxy and the proxy overwrites the header — see README "Admin panel".
ADMIN_AUTH_HEADER=
# Comma-separated user names allowed in that way (empty = any user the proxy lets through)
ADMIN_AUTH_USERS=
# Logout button target for single sign-on users, e.g. your proxy's logout page
ADMIN_LOGOUT_URL=

# Optional Telegram notifications: bot token from @BotFather (one app per token).
# Set PUBLIC_URL too, so messages link back to the project.
TELEGRAM_BOT_TOKEN=
# Seconds of quiet before a digest of new comments is sent (default 120)
TELEGRAM_DIGEST_SECONDS=
